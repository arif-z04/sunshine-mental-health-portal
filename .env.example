# =============================================================================
# SUNSHINE MENTAL HEALTH PORTAL (BANGLADESH) — ENVIRONMENT CONFIGURATION
# =============================================================================

# ASP.NET Core Runtime Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sunshine_db
DB_USER=sunshine_user
DB_PASSWORD=SunshinePass123!
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sunshine_db;Username=sunshine_user;Password=SunshinePass123!

# JWT Token Security Configuration
Jwt__Key=SunshineCounselingSecretKey2026!MustBeVerySecureAnd32BytesLong
Jwt__Issuer=Sunshine.Api
Jwt__Audience=Sunshine.Client
Jwt__ExpiryDays=7

# Bangladesh Telehealth & Meeting Service
TELEHEALTH_MEETING_BASE_URL=https://meet.sunshine.org.bd

# Mobile Financial Services (MFS) Sandbox & Production API Credentials
BKASH_MERCHANT_NUMBER=01700000000
BKASH_APP_KEY=sandbox_bkash_key_2026
BKASH_APP_SECRET=sandbox_bkash_secret_2026
NAGAD_MERCHANT_ID=sandbox_nagad_merchant
ROCKET_MERCHANT_ID=sandbox_rocket_merchant

# Emergency Hotlines (Bangladesh)
HOTLINE_KAAN_PETE_ROI=+8801779554391
HOTLINE_EMERGENCY_NATIONAL=999
HOTLINE_SHASTHYO_BATAYON=16263
